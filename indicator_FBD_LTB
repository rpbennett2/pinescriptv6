//@version=6
indicator("ES Daily Core Strategy", shorttitle="ES Core", overlay=true)

// ==========================================
// INPUT PARAMETERS
// ==========================================

// RSI Settings
rsi_length = input.int(14, "RSI Length", minval=1)
rsi_source = input.source(close, "RSI Source")

// Structure Settings
swing_length = input.int(8, "Swing Length for S/R", minval=5, maxval=15)
min_touches = input.int(25, "Minimum Level Touches", minval=2, maxval=50)
level_tolerance = input.float(0.15, "Level Tolerance %", minval=0.05, maxval=0.5) / 100
min_level_strength = input.int(20, "Minimum Level Strength", minval=10, maxval=50)

// Trend Settings
trend_ma_length = input.int(50, "Trend MA Length", minval=20, maxval=200)
higher_tf = input.timeframe("120", "Higher Timeframe for Trend")

// Quality Filters
min_impulse_size = input.float(10, "Minimum Impulse Size (points)", minval=5, maxval=50)
volume_filter = input.bool(true, "Use Volume Filter")
session_filter = input.bool(true, "RTH Session Only")

// Visual Settings
show_ltb = input.bool(true, "Show LTB Setups")
show_fbd = input.bool(true, "Show FBD Setups")
show_divergence = input.bool(true, "Show RSI Divergence")
show_levels = input.bool(true, "Show Key Levels")
show_level_strength = input.bool(true, "Show Level Strength")

// Alert Settings
enable_alerts = input.bool(false, "Enable Alerts")

// ==========================================
// SESSION FILTER
// ==========================================

is_rth = session_filter ? not na(time(timeframe.period, "0930-1600:1234567", "America/New_York")) : true

// ==========================================
// RSI CALCULATION
// ==========================================

rsi = ta.rsi(rsi_source, rsi_length)
rsi_oversold = 40
rsi_overbought = 60

rsi_tradeable_zone = rsi >= rsi_oversold and rsi <= rsi_overbought
rsi_weak_long = rsi < rsi_oversold
rsi_weak_short = rsi > rsi_overbought

// ==========================================
// TREND IDENTIFICATION
// ==========================================

// Higher timeframe trend
htf_close = request.security(syminfo.tickerid, higher_tf, close[1], lookahead=barmerge.lookahead_off)

// Trend determination
trend_ma = ta.ema(close, trend_ma_length)
price_above_ma = close > trend_ma
htf_bullish = htf_close > htf_close[2]
htf_bearish = htf_close < htf_close[2]

// Strong trend conditions
is_strong_uptrend = price_above_ma and htf_bullish and close > close[5]
is_strong_downtrend = not price_above_ma and htf_bearish and close < close[5]

// ==========================================
// LEVEL DETECTION & SCORING
// ==========================================

// Pivot detection with larger lookback for significant levels
pivot_high = ta.pivothigh(high, swing_length, swing_length)
pivot_low = ta.pivotlow(low, swing_length, swing_length)

// Level storage with enhanced properties
type LevelData
    float price
    int touches
    int first_touch_bar
    int last_touch_bar
    float strength
    bool is_fresh
    float max_impulse_away

var resistance_levels = array.new<LevelData>()
var support_levels = array.new<LevelData>()

// Calculate level strength
calc_level_strength(int touches, int age, float max_impulse) =>
    touches * 10 + math.max(0, 100 - age * 0.5) + math.min(max_impulse * 2, 50)

// Method to update or add level
method update_or_add_level(array<LevelData> levels, float price, bool is_resistance) =>
    level_found = false
    if levels.size() > 0
        for i = 0 to levels.size() - 1
            level = levels.get(i)
            if math.abs(level.price - price) <= price * level_tolerance
                // Update existing level
                new_touches = level.touches + 1
                age = bar_index - level.first_touch_bar
                new_level = LevelData.new(                    price,                     new_touches,                     level.first_touch_bar,                     bar_index,                    calc_level_strength(new_touches, age, level.max_impulse_away),                    new_touches <= 2,                     level.max_impulse_away                )
                levels.set(i, new_level)
                level_found := true
                break
    
    if not level_found
        // Add new level
        new_level = LevelData.new(            price,             1,             bar_index,             bar_index,            calc_level_strength(1, 0, 0),            true,            0.0        )        
        levels.push(new_level)                
        if levels.size() > 8
            // Remove weakest level
            min_strength = 999999.0
            min_index = 0
            for i = 0 to levels.size() - 1
                level = levels.get(i)
                if level.strength < min_strength
                    min_strength := level.strength
                    min_index := i
            levels.remove(min_index)

// Add levels when pivots are confirmed
if not na(pivot_high) and is_rth
    resistance_levels.update_or_add_level(pivot_high, true)

if not na(pivot_low) and is_rth
    support_levels.update_or_add_level(pivot_low, false)

// Update impulse tracking for existing levels
method update_impulse_tracking(array<LevelData> levels) =>
    if levels.size() > 0
        for i = 0 to levels.size() - 1
            level = levels.get(i)
            current_impulse = math.abs(close - level.price)
            if current_impulse > level.max_impulse_away
                updated_level = LevelData.new(level.price, level.touches, level.first_touch_bar,
                                              level.last_touch_bar, level.strength, level.is_fresh, current_impulse)
                levels.set(i, updated_level)

resistance_levels.update_impulse_tracking()
support_levels.update_impulse_tracking()

// ==========================================
// DIVERGENCE DETECTION
// ==========================================

div_len = 5
rsi_ph = ta.pivothigh(rsi, div_len, div_len)
rsi_pl = ta.pivotlow(rsi, div_len, div_len)
price_ph = ta.pivothigh(high, div_len, div_len)
price_pl = ta.pivotlow(low, div_len, div_len)

// Selective divergence detection
bullish_div = not na(rsi_pl) and not na(rsi_pl[1]) and not na(price_pl) and not na(price_pl[1]) and
              price_pl < price_pl[1] and rsi_pl > rsi_pl[1] and rsi_pl[1] < 45

bearish_div = not na(rsi_ph) and not na(rsi_ph[1]) and not na(price_ph) and not na(price_ph[1]) and
              price_ph > price_ph[1] and rsi_ph < rsi_ph[1] and rsi_ph[1] > 55

// ==========================================
// QUALITY LTB DETECTION
// ==========================================

// Find nearest quality level (consolidated function)
get_nearest_quality_level(array<LevelData> levels) =>
    nearest_level = 0.0
    max_strength = 0.0

    if levels.size() > 0
        for i = 0 to levels.size() - 1
            level = levels.get(i)
            if level.strength >= min_level_strength and level.touches >= min_touches
                distance = math.abs(close - level.price)
                if distance <= level.price * level_tolerance and level.strength > max_strength
                    max_strength := level.strength
                    nearest_level := level.price
    nearest_level

quality_support = get_nearest_quality_level(support_levels)
quality_resistance = get_nearest_quality_level(resistance_levels)

// Volume filter
avg_volume = ta.sma(volume, 20)
volume_confirmation = not volume_filter or volume > avg_volume * 0.8

// Enhanced LTB conditions
ltb_long = quality_support > 0 and is_strong_uptrend and rsi_tradeable_zone and volume_confirmation and show_ltb and is_rth
ltb_short = quality_resistance > 0 and is_strong_downtrend and rsi_tradeable_zone and volume_confirmation and show_ltb and is_rth

// ==========================================
// FBD DETECTION
// ==========================================

var float fbd_level = na
var bool fbd_monitoring = false
var int fbd_start_bar = 0
var int fbd_touches = 0

// Detect flush below quality support level
if support_levels.size() > 0 and not fbd_monitoring
    for i = 0 to support_levels.size() - 1
        level = support_levels.get(i)
        if level.touches >= 3 and level.strength >= min_level_strength and
           low < level.price and low[1] >= level.price
            fbd_level := level.price
            fbd_monitoring := true
            fbd_start_bar := bar_index
            fbd_touches := level.touches
            break

// FBD reclaim conditions
fbd_reclaim = fbd_monitoring and close > fbd_level and (bar_index - fbd_start_bar) <= 5 and
              fbd_touches >= 3 and volume > avg_volume * 1.2 and show_fbd and is_rth

// Reset monitoring after timeout or successful reclaim
if fbd_monitoring and ((bar_index - fbd_start_bar) > 10 or fbd_reclaim)
    fbd_monitoring := false
    fbd_level := na

// ==========================================
// VISUAL ELEMENTS
// ==========================================

// Trend MA
ma_color = is_strong_uptrend ? color.green : is_strong_downtrend ? color.red : color.gray
plot(trend_ma, "Trend MA", color=ma_color, linewidth=2)

// Quality levels plotting function
plot_quality_levels(array<LevelData> levels, color fresh_color, color aged_color, color label_color) =>
    if show_levels and levels.size() > 0
        for i = 0 to levels.size() - 1
            level = levels.get(i)
            if level.strength >= min_level_strength and level.touches >= min_touches
                line_color = level.is_fresh ? fresh_color : aged_color
                line_width = level.touches >= 4 ? 2 : 1
                line.new(bar_index - 50, level.price, bar_index + 20, level.price,
                         color=line_color, style=line.style_solid, width=line_width)
                if show_level_strength
                    label.new(bar_index + 15, level.price, str.tostring(level.touches) + "T",
                             color=label_color, textcolor=color.white, size=size.large, style=label.style_label_left)

plot_quality_levels(support_levels, color.lime, color.green, color.green)
plot_quality_levels(resistance_levels, color.orange, color.red, color.red)

// Setup signals
plotshape(ltb_long, "LTB Long", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.large)
plotshape(ltb_short, "LTB Short", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.large)
plotshape(fbd_reclaim, "FBD Setup", shape.diamond, location.belowbar, color.new(color.blue, 0), size=size.large)

// Divergence signals
plotshape(bullish_div and show_divergence, "Bull Div", shape.labelup, location.belowbar,
          color.lime, text="BD+", textcolor=color.black, size=size.normal)
plotshape(bearish_div and show_divergence, "Bear Div", shape.labeldown, location.abovebar,
          color.orange, text="BD-", textcolor=color.black, size=size.normal)

// Background color for extreme RSI zones
bgcolor(rsi_weak_long or rsi_weak_short ? color.new(color.red, 98) : color.new(color.white, 100))

// ==========================================
// STATUS TABLE (Streamlined)
// ==========================================

var info_table = table.new(position.bottom_right, 2, 5, bgcolor=color.white, border_width=1)

// Helper function to add table row
add_table_row(int row, string label_text, string value_text, color value_color) =>
    info_table.cell(0, row, label_text, text_color=color.black, bgcolor=color.gray)
    info_table.cell(1, row, value_text, text_color=value_color)

if barstate.islast
    // RSI with zone status
    rsi_zone_text = rsi_weak_long ? " (WEAK L)" : rsi_weak_short ? " (WEAK S)" : " (OK)"
    rsi_color = rsi_weak_long or rsi_weak_short ? color.red : color.green
    add_table_row(0, "RSI", str.tostring(math.round(rsi, 1)) + rsi_zone_text, rsi_color)

    // Trend
    trend_text = is_strong_uptrend ? "STRONG UP" : is_strong_downtrend ? "STRONG DOWN" : "NEUTRAL"
    trend_color = is_strong_uptrend ? color.green : is_strong_downtrend ? color.red : color.gray
    add_table_row(1, "Trend", trend_text, trend_color)

    // Levels (combined)
    sup_text = quality_support > 0 ? str.tostring(quality_support, "0.00") : "-"
    res_text = quality_resistance > 0 ? str.tostring(quality_resistance, "0.00") : "-"
    levels_text = sup_text + " / " + res_text
    add_table_row(2, "S / R", levels_text, color.black)

    // LTB Status (combined)
    ltb_text = ltb_long ? "LONG" : ltb_short ? "SHORT" : "NONE"
    ltb_color = ltb_long ? color.green : ltb_short ? color.red : color.gray
    add_table_row(3, "LTB", ltb_text, ltb_color)

    // FBD Status
    fbd_text = fbd_reclaim ? "ACTIVE" : fbd_monitoring ? "WATCH" : "NONE"
    fbd_color = fbd_reclaim ? color.blue : fbd_monitoring ? color.yellow : color.gray
    add_table_row(4, "FBD", fbd_text, fbd_color)

// ==========================================
// ALERTS
// ==========================================

alertcondition(ltb_long and enable_alerts, "LTB Long", "Quality Level Trackback Long")
alertcondition(ltb_short and enable_alerts, "LTB Short", "Quality Level Trackback Short")
alertcondition(fbd_reclaim and enable_alerts, "FBD Reclaim", "Quality Failed Breakdown")
alertcondition(bullish_div and enable_alerts, "Bullish Divergence", "Bullish RSI divergence")
alertcondition(bearish_div and enable_alerts, "Bearish Divergence", "Bearish RSI divergence")
