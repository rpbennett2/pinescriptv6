// PCA Breadth Composite — Enhanced v2.1 (Refined Signals - Less Noise)
//@version=6
indicator("PCA-BC Enhanced v2.1", shorttitle="PCA-BC Enhanced v2.1", overlay=false, dynamic_requests=true)
import TradingView/ta/10

// ── Profile / Parameters
profile     = input.string("Auto", "Intraday Profile", options=["Auto","1m","5m","15m"])
matchChart  = input.bool(false, "Match Chart TF for data/VX/VIX")
showTable   = input.bool(true, "Show Info Table", group="Display Settings")

is1  = timeframe.isminutes and timeframe.multiplier == 1
is5  = timeframe.isminutes and timeframe.multiplier == 5
is15 = timeframe.isminutes and timeframe.multiplier == 15
resolved = profile == "Auto" ? (is1 ? "1m" : is5 ? "5m" : is15 ? "15m" : "5m") : profile

// --- Refined Selectivity controls (TIGHTER FILTERING)
proj_smooth_len = input.int(5, "Proj Smoothing (EMA)", minval=1)  // Increased from 3
spread_k_sigma  = input.float(0.18, "Min EMA-Spread (k·σ_proj)", step=0.01)  // Increased from 0.12
band_extra_k    = input.float(0.15, "Extra Distance from Band (k·σ_proj)", step=0.01)  // Increased from 0.10
N_hold          = input.int(3, "Bars to Hold Condition", minval=1, maxval=10)  // Increased from 2
N_cool          = input.int(15, "Cooldown Bars After Flip", minval=0, maxval=200)  // Increased from 10
useHTFConfirm   = input.bool(true, "Require 60min Trend Agreement")

// Correct TF mapping
string _data_tf = resolved == "1m" ? "1"  : resolved == "5m" ? "5"  : "15"
string _vx_tf   = resolved == "1m" ? "2"  : resolved == "5m" ? "5"  : "10"
string _vix_tf  = resolved == "1m" ? "5"  : "15"

string data_tf = matchChart ? timeframe.period : _data_tf
string vx_tf   = matchChart ? timeframe.period : _vx_tf
string vix_tf  = matchChart ? timeframe.period : _vix_tf

// Windows tuned to 1m/5m/15m
int pca_window = resolved == "1m" ? 240 : resolved == "5m" ? 96 : 64
int fast_len   = resolved == "1m" ? 14  : resolved == "5m" ? 9  : 5
int slow_len   = resolved == "1m" ? 40  : resolved == "5m" ? 21 : 12

regime_lookback = input.int(365, "Regime Lookback")
w_m2m1  = input.float(1.50, "Weight: M2/M1",          step=0.1)
w_short = input.float(0.50, "Weight: VX1 vs VIX9D",   step=0.1)

// Band: base k, min floor, smoother regime scaling (TIGHTER BANDS)
sigLen   = input.int(100, "Sigma Len (proj)")
bandK    = input.float(0.25, "Base No-Trade Band (k·σ)", step=0.01)  // Increased from 0.20
bandMin  = input.float(0.12, "Band Floor (k·σ min)",     step=0.01)  // Increased from 0.08
rthOnly  = input.bool(true, "Only trade RTH (0630–1500 CT)")
m3_mode  = input.string("Manual", "M3 Source", options = ["Manual","VIX3M Proxy","Off"])

// ── Symbols
symTick = input.symbol("USI:TICK", "TICK")
symAdd  = input.symbol("USI:ADD",  "ADD")
symVold = input.symbol("USI:VOLD", "VOLD")
symVX1  = input.symbol("CBOE:VX1!", "VX1!")
symVX2  = input.symbol("CBOE:VX2!", "VX2!")
symVX3_manual = input.symbol("CBOE:VXZ2025", "VX M3 (manual)")
symVIX    = input.symbol("CBOE:VIX",   "VIX")
symVIX3M  = input.symbol("CBOE:VIX3M", "VIX3M")
symVIX9D  = input.symbol("CBOE:VIX9D", "VIX9D")

// ═══════════════════════════════════════════════════════════════════════════════
// REFINED CVD CALCULATION - MUCH MORE SELECTIVE
// ═══════════════════════════════════════════════════════════════════════════════

// CVD Configuration (MORE CONSERVATIVE SETTINGS)
groupCVD = "CVD Volume Analysis"
enableCVD = input.bool(true, "Enable CVD Analysis", group=groupCVD)
cvdSmoothPeriod = input.int(8, "CVD Smoothing Period", minval=1, maxval=20, group=groupCVD)  // Increased from 5
cvdDivThreshold = input.float(2.0, "CVD Divergence Threshold (ATR)", minval=0.5, step=0.1, group=groupCVD)  // Increased from 1.2
cvdWeight = input.float(0.20, "CVD Signal Weight", minval=0.0, maxval=1.0, step=0.05, group=groupCVD)  // Reduced from 0.25
cvdMinBars = input.int(15, "Min Bars Between CVD Signals", minval=5, maxval=50, group=groupCVD)  // NEW: Cooldown for CVD

// CVD timeframe settings based on chart resolution
cvdLowerTF = "1"
cvdCumulativePeriod = "D"  // Daily cumulative period (resets each trading day)

// Use native TradingView volume delta function
// Request native CVD from lower timeframe with daily reset
// Assign each value separately (no tuple unpacking in Pine Script)
[vd_open, vd_high, vd_low, vd_current] =  ta.requestVolumeDelta(cvdLowerTF, cvdCumulativePeriod)

// Use the current CVD value (cumulative within the day)
cvdRaw = vd_current

// Normalize CVD by average volume to prevent scaling issues
avg_volume = ta.sma(volume, 50)
cvdNormalized = avg_volume > 0 ? cvdRaw / avg_volume : 0.0

// Safety: clamp extreme values for display
cvdClamped = math.max(math.min(cvdNormalized, 1000.0), -1000.0)

// Smooth CVD and calculate momentum
cvdSmooth = ta.ema(cvdClamped, cvdSmoothPeriod)
cvdMomentum = ta.roc(cvdSmooth, 10)
cvdAtr = math.max(ta.stdev(cvdSmooth, 14), 0.1)


// MUCH MORE SELECTIVE CVD Divergence Detection
var int lastCvdBullBar = 0
var int lastCvdBearBar = 0

detect_cvd_divergence() =>
    // Only check for divergences if enough bars have passed
    cvd_cooldown_ok = bar_index - math.max(lastCvdBullBar, lastCvdBearBar) >= cvdMinBars
    
    if not cvd_cooldown_ok
        [false, false]
    else
        // More stringent divergence requirements
        lookback_bars = 20  // Increased lookback
        
        // Bullish divergence: significant price decline + CVD improvement
        price_decline = (low - ta.lowest(low[1], lookback_bars)) / ta.lowest(low[1], lookback_bars)
        cvd_improvement = (cvdSmooth - ta.lowest(cvdSmooth[1], lookback_bars)) / math.abs(ta.lowest(cvdSmooth[1], lookback_bars))
        
        // Bearish divergence: significant price rise + CVD deterioration  
        price_rise = (high - ta.highest(high[1], lookback_bars)) / ta.highest(high[1], lookback_bars)
        cvd_deterioration = (ta.highest(cvdSmooth[1], lookback_bars) - cvdSmooth) / math.abs(ta.highest(cvdSmooth[1], lookback_bars))
        
        // MUCH STRICTER THRESHOLDS
        bullish_div = price_decline < -0.02 and cvd_improvement > 0.15 and math.abs(cvdMomentum) > cvdDivThreshold
        bearish_div = price_rise > 0.02 and cvd_deterioration > 0.15 and math.abs(cvdMomentum) > cvdDivThreshold
        
        [bullish_div, bearish_div]

[cvd_bull_div_raw, cvd_bear_div_raw] = detect_cvd_divergence()

// Update last divergence bars
if cvd_bull_div_raw
    lastCvdBullBar := bar_index
if cvd_bear_div_raw  
    lastCvdBearBar := bar_index

// Final CVD signals (only when confirmed)
cvd_bull_div = cvd_bull_div_raw
cvd_bear_div = cvd_bear_div_raw

// CVD Signal Strength (normalized by ATR) - MORE CONSERVATIVE
cvd_signal_strength = enableCVD ? math.min(math.abs(cvdMomentum) / cvdAtr, 2.0) : 0.0  // Capped at 2.0

// ── Fetch original data
tck  = request.security(symTick, data_tf, close)
add  = request.security(symAdd,  data_tf, close)
vold = request.security(symVold, data_tf, close)
vx1  = request.security(symVX1,  vx_tf,   close)
vx2  = request.security(symVX2,  vx_tf,   close)
vx3  = m3_mode == "Manual"       ? request.security(symVX3_manual, vx_tf, close) : na
vix  = m3_mode == "VIX3M Proxy"  ? request.security(symVIX,        vix_tf, close) : na
vix3 = m3_mode == "VIX3M Proxy"  ? request.security(symVIX3M,      vix_tf, close) : na
v9d  = request.security(symVIX9D, vix_tf, close)

// ── Helpers
f_clamp(x, lo, hi) => x < lo ? lo : x > hi ? hi : x
f_robust_z(src, n) =>
    m   = ta.median(src, n)
    mad = ta.median(math.abs(src - m), n)
    z   = (mad == 0) ? 0 : (src - m) / (mad * 1.4826)
    f_clamp(z, -6.0, 6.0)
f_z_ratio(num, den, n) =>
    v = (den != 0) ? (num/den - 1.0) : na
    v := f_clamp(nz(v), -0.35, 0.35)   // tighter winsorize for 5m A/B
    f_robust_z(v, n)
f_trend(f, s) => na(f) or na(s) ? "n/a" : f > s ? "Up" : f < s ? "Down" : "Flat"

// ── Features
z1 = f_robust_z(tck,  pca_window)
z2 = f_robust_z(add,  pca_window)
z3 = f_robust_z(vold, pca_window)
z4 = f_z_ratio(vx2, vx1, pca_window)
z5 = m3_mode == "Manual" ? f_z_ratio(vx3, vx1, pca_window) :
     m3_mode == "VIX3M Proxy" ? f_z_ratio(vix3, vix, pca_window) : 0.0
z6 = f_z_ratio(vx1, v9d, pca_window)

z4w = w_m2m1  * z4
z6w = w_short * z6
arr = array.from(z1, z2, z3, z4w, z5, z6w)

// ── Correlation PCA (6×6) + sign lock
corr = matrix.new<float>(6,6,0.0)
for i=0 to 5
    for j=0 to 5
        cij = ta.correlation(array.get(arr,i), array.get(arr,j), pca_window)
        matrix.set(corr, i, j, nz(cij))
eigVal = corr.eigenvalues()
eigVec = corr.eigenvectors()

var bool pc_prev_init = false
var array<float> pc_prev = array.new<float>(6, 0.0)
f_dot(a, b) => a.get(0)*b.get(0)+a.get(1)*b.get(1)+a.get(2)*b.get(2)+a.get(3)*b.get(3)+a.get(4)*b.get(4)+a.get(5)*b.get(5)
f_mult(arrF, k) =>
    r = array.new<float>(array.size(arrF))
    for i=0 to array.size(arrF)-1
        array.set(r, i, arrF.get(i)*k)
    r
pc_now = eigVec.col(0)
same_dir = not pc_prev_init or (f_dot(pc_now, pc_prev) >= 0)
pc_aligned = same_dir ? pc_now : f_mult(pc_now, -1.0)
for i=0 to 5
    array.set(pc_prev, i, pc_aligned.get(i))
pc_prev_init := true

proj = array.get(arr,0)*pc_aligned.get(0) + array.get(arr,1)*pc_aligned.get(1) + array.get(arr,2)*pc_aligned.get(2) + array.get(arr,3)*pc_aligned.get(3) + array.get(arr,4)*pc_aligned.get(4) + array.get(arr,5)*pc_aligned.get(5)

// Normalize projection to unit variance using PC1 eigenvalue
ev1 = math.max(eigVal.get(0), 1e-9)
proj_n = proj / math.sqrt(ev1)

// (optional) clip for plotting aesthetic
proj_n := f_clamp(proj_n, -6.0, 6.0)

// Use proj_n for everything below instead of proj
proj_s = ta.ema(proj_n, proj_smooth_len)
fast   = ta.ema(proj_s, fast_len)
slow   = ta.ema(proj_s, slow_len)

// If you normalize, σ(proj_n) ≈ 1 → replace sigProj with 1 for thresholds:
sigProj = 1.0

// ═══════════════════════════════════════════════════════════════════════════════
// DYNAMIC THRESHOLD ADAPTATION SYSTEM (SLIGHTLY MORE CONSERVATIVE)
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic Threshold Configuration
groupDynamic = "Dynamic Thresholds"
useDynamicThresholds = input.bool(true, "Enable Dynamic Thresholds", group=groupDynamic)
baseThresholdMultiplier = input.float(1.1, "Base Threshold Multiplier", minval=0.5, maxval=2.0, step=0.1, group=groupDynamic)  // Increased from 1.0
volatilityLookback = input.int(75, "Volatility Lookback", minval=20, maxval=200, group=groupDynamic)  // Increased from 50
adaptationSpeed = input.float(0.08, "Adaptation Speed", minval=0.01, maxval=0.5, step=0.01, group=groupDynamic)  // Reduced from 0.1

// Volatility-based threshold calculation
calculate_dynamic_thresholds() =>
    // Base volatility measures
    //atr_volatility = ta.atr(14)
    proj_volatility = ta.stdev(proj_s, volatilityLookback)
    
    // Normalize volatilities
    //atr_normalized = atr_volatility / ta.sma(atr_volatility, volatilityLookback)
    //proj_vol_normalized = proj_volatility / ta.sma(proj_volatility, volatilityLookback)
    // Safe normalization with fallback
    proj_vol_sma = ta.sma(proj_volatility, volatilityLookback)
    proj_vol_normalized = proj_vol_sma > 0 ? proj_volatility / proj_vol_sma : 1.0
    
    // Time-of-day adjustment (higher thresholds during open/close)
    hour_adjustment = switch hour
        9 => 1.3   // Market open
        10 => 1.15  // Early session
        15 => 1.2  // Late session  
        16 => 1.4  // Market close
        => 1.0     // Regular hours
    
    // Final dynamic threshold multiplier with safety check
    dynamic_factor = proj_vol_normalized * hour_adjustment
    result = baseThresholdMultiplier * dynamic_factor
    
    // Ensure we never return NaN
    na(result) ? baseThresholdMultiplier : result
 

// Adaptive threshold variables with exponential smoothing
var float adaptive_band_threshold = 0.20   // Higher starting point
var float adaptive_spread_threshold = 0.15  // Higher starting point

current_threshold_multiplier = calculate_dynamic_thresholds()

if useDynamicThresholds
    // Smooth adaptation to prevent whipsawing
    target_band = current_threshold_multiplier * 0.20    // Higher base
    target_spread = current_threshold_multiplier * 0.15  // Higher base
    
    adaptive_band_threshold := adaptive_band_threshold + (target_band - adaptive_band_threshold) * adaptationSpeed
    adaptive_spread_threshold := adaptive_spread_threshold + (target_spread - adaptive_spread_threshold) * adaptationSpeed
else
    // Use static thresholds
    adaptive_band_threshold := bandK
    adaptive_spread_threshold := spread_k_sigma

// ── Filters
// --- Smooth projection more before EMAs
//proj_s = ta.ema(proj, proj_smooth_len)

// Trend filters on projection
//fast = ta.ema(proj_s, fast_len)
//slow = ta.ema(proj_s, slow_len)
 
// ── Non-repainting HTF trends - FIXED
// Remove the _sec_confirm function entirely
// Use direct requests like the working version:
fast_30 = request.security(syminfo.tickerid, "30", fast[1])
slow_30 = request.security(syminfo.tickerid, "30", slow[1])
fast_60 = request.security(syminfo.tickerid, "60", fast[1])
slow_60 = request.security(syminfo.tickerid, "60", slow[1])
fast_240 = request.security(syminfo.tickerid, "240", fast[1])
slow_240 = request.security(syminfo.tickerid, "240", slow[1])
fast_D = request.security(syminfo.tickerid, "D", fast[1])
slow_D = request.security(syminfo.tickerid, "D", slow[1])

//trend30m = f_trend(fast, slow_30)
//trend1h = f_trend(fast_60, slow_60)
//trend4h = f_trend(fast_240, slow_240)
//trendD = f_trend(fast_D, slow_D)

// steadier regime scaling: EMA( conc, 50 ) and clamp
totVar = array.sum(eigVal)
conc   = totVar > 0 ? eigVal.get(0)/totVar : na
conc_s = ta.ema(conc, 50)
//sigProj = ta.stdev(proj, sigLen)
effK    = f_clamp(bandK * (1 - nz(conc_s)), 0.6*bandK, bandK)  // Higher minimum floor

// RTH gate (0830–1500 CT)
f_inSession(sess) => not na(time(timeframe.period, sess))
inRTH = (not rthOnly) or f_inSession("0630-1500:1234567")

// ── Term-structure calculations (for VIX regime analysis)
f_pct(x) => na(x) ? "n/a" : str.tostring(math.round(x * 10000.0) / 100.0) + "%"
m2m1 = na(vx1) or na(vx2) ? na : (vx2 / vx1 - 1.0)
m3m1 = m3_mode == "Manual"  ? (na(vx3) or na(vx1) ? na : (vx3 / vx1 - 1.0))
      : m3_mode == "VIX3M Proxy" ? (na(vix3) or na(vix) ? na : (vix3 / vix - 1.0)) : na
shortSlope = na(vx1) or na(v9d) ? na : (vx1 / v9d - 1.0)
tsLabel = na(m2m1) ? "n/a" : m2m1 > 0 ? "Contango" : m2m1 < 0 ? "Backwardation" : "Flat"
tsColor = na(m2m1) ? color.gray : m2m1 > 0 ? color.new(color.green, 0) : color.new(color.red, 0)

// ═══════════════════════════════════════════════════════════════════════════════
// ENHANCED VIX REGIME FILTERING (SLIGHTLY MORE CONSERVATIVE)
// ═══════════════════════════════════════════════════════════════════════════════

// Enhanced VIX Regime Configuration  
groupVixEnhanced = "Enhanced VIX Regime"
useEnhancedVixFiltering = input.bool(true, "Enable Enhanced VIX Filtering", group=groupVixEnhanced)
vixRegimeWeight = input.float(0.12, "VIX Regime Signal Weight", minval=0.0, maxval=0.5, step=0.01, group=groupVixEnhanced)  // Reduced from 0.15

// Enhanced VIX regime analysis (building on existing m2m1, m3m1 calculations)
analyze_vix_regime() =>
    if not useEnhancedVixFiltering or na(m2m1)
        [0, "Unknown", 1.0]
    else
        // Multiple slope analysis for curve shape
        front_slope = m2m1  // Already calculated: (vx2/vx1 - 1.0)
        back_slope = na(m3m1) ? 0.0 : m3m1  // M3/M1 slope if available
        
        // Curve shape classification (MORE CONSERVATIVE THRESHOLDS)
        steep_threshold = 0.06  // Increased from 0.05
        flat_threshold = 0.015  // Increased from 0.01
        
        // VIX regime classification (-2 to +2 scale)
        vix_regime = switch
            front_slope < -steep_threshold => -2    // Deep backwardation (crisis)
            front_slope < -flat_threshold => -1     // Backwardation (stress)
            front_slope > steep_threshold => 2      // Steep contango (complacent)  
            front_slope > flat_threshold => 1       // Contango (elevated)
            => 0                                     // Flat (normal)
        
        // Risk regime text classification
        risk_regime = switch vix_regime
            -2 => "Crisis"
            -1 => "Stress"
            0 => "Normal" 
            1 => "Elevated"
            2 => "Complacent"
            => "Unknown"
        
        // Signal adjustment factor (LESS AGGRESSIVE ADJUSTMENTS)
        regime_adjustment = switch vix_regime
            -2 => 0.7      // Easier signals in crisis (70% vs 60% before)
            -1 => 0.85     // Easier signals in stress (85% vs 80% before)
            0 => 1.0       // Standard thresholds in normal conditions
            1 => 1.15      // Slightly harder signals when elevated (115% vs 120% before)
            2 => 1.25      // Harder signals when complacent (125% vs 140% before)
            => 1.0
        
        [vix_regime, risk_regime, regime_adjustment]

[vix_ts_regime, vix_risk_regime, vix_regime_multiplier] = analyze_vix_regime()

// Apply VIX regime adjustment to thresholds
enhanced_band_threshold = adaptive_band_threshold * vix_regime_multiplier
enhanced_spread_threshold = adaptive_spread_threshold * vix_regime_multiplier

// ═══════════════════════════════════════════════════════════════════════════════  
// REFINED SIGNAL LOGIC - MUCH MORE SELECTIVE
// ═══════════════════════════════════════════════════════════════════════════════

// Apply enhanced thresholds instead of static ones
effBand = math.max(bandMin*sigProj, enhanced_band_threshold*sigProj)
min_spread = enhanced_spread_threshold * sigProj
band_extra = band_extra_k * sigProj

// --- Hysteresis margins (WIDER MARGINS)
farAbove  = proj_s >  (effBand + band_extra)
farBelow  = proj_s < -(effBand + band_extra)
spreadUp  = (fast - slow) >  min_spread
spreadDn  = (slow - fast) >  min_spread

// MUCH MORE SELECTIVE CVD confirmation
//cvd_confirmation_long = not enableCVD or (cvd_bull_div and cvdMomentum > cvdDivThreshold * 1.5)  // Stricter requirement
//cvd_confirmation_short = not enableCVD or (cvd_bear_div and cvdMomentum < -cvdDivThreshold * 1.5)  // Stricter requirement

// BALANCED CVD confirmation - supportive, not blocking
cvd_confirmation_long = not enableCVD or  (cvd_bull_div or cvdMomentum > 0.5 or cvdSmooth > ta.ema(cvdSmooth, 20))

cvd_confirmation_short = not enableCVD or  (cvd_bear_div or cvdMomentum < -0.5 or cvdSmooth < ta.ema(cvdSmooth, 20))

// OR make it even simpler - CVD adds strength but doesn't block signals:
cvd_supportive_long = not enableCVD or cvdMomentum >= 0.0
cvd_supportive_short = not enableCVD or cvdMomentum <= 0.0

// Enhanced signal logic
wantLong = inRTH and farAbove and spreadUp and cvd_supportive_long
wantShort= inRTH and farBelow and spreadDn and cvd_supportive_short



// REQUIRE BOTH HTF AND DAILY ALIGNMENT for higher confidence
//htfOK_Long  = not useHTFConfirm or (trend1h == "Up" and trendD != "Down")
//htfOK_Short = not useHTFConfirm or (trend1h == "Down" and trendD != "Up")

// Enhanced signal logic with stricter CVD confirmation
//wantLong = inRTH and farAbove and spreadUp and htfOK_Long and cvd_confirmation_long
//wantLong = inRTH and farAbove and spreadUp and cvd_confirmation_long
//wantShort= inRTH and farBelow and spreadDn and htfOK_Short and cvd_confirmation_short
//wantShort= inRTH and farBelow and spreadDn and cvd_confirmation_short

// Signal strength calculation (for future position sizing)
signal_strength_long = 0.0
signal_strength_short = 0.0

if wantLong
    pca_strength = math.abs(proj_s) / sigProj
    cvd_strength = enableCVD ? math.min(cvd_signal_strength, 1.5) : 0.5  // Cap CVD influence
    regime_strength = vix_regime_multiplier < 1.0 ? 1.3 : 0.8  // Reduced from 1.5/0.7
    signal_strength_long := (pca_strength * 0.65 + cvd_strength * cvdWeight + regime_strength * vixRegimeWeight)

if wantShort  
    pca_strength = math.abs(proj_s) / sigProj
    cvd_strength = enableCVD ? math.min(cvd_signal_strength, 1.5) : 0.5  // Cap CVD influence
    regime_strength = vix_regime_multiplier < 1.0 ? 1.3 : 0.8  // Reduced from 1.5/0.7
    signal_strength_short := (pca_strength * 0.65 + cvd_strength * cvdWeight + regime_strength * vixRegimeWeight)

// --- Debounce + cooldown (LONGER COOLDOWNS)
var int holdUp   = 0
var int holdDn   = 0
var int cooldown = 0
var int dir      = 0     // +1 long, -1 short, 0 neutral

holdUp  := wantLong  ? math.min(holdUp + 1, 1000) : 0
holdDn  := wantShort ? math.min(holdDn + 1, 1000) : 0
cooldown:= math.max(cooldown - 1, 0)

flipLong  = cooldown == 0 and holdUp  >= N_hold and dir <= 0
flipShort = cooldown == 0 and holdDn  >= N_hold and dir >= 0

if flipLong
    dir := 1
    cooldown := N_cool
else if flipShort
    dir := -1
    cooldown := N_cool

// "OK" states for plotting/alerts (edge-triggered by flips)
longEvent  = flipLong
shortEvent = flipShort

// Continuous state
inLong = dir == 1
inShort= dir == -1

// Define inBand: Are we inside the no-trade (neutral) band?
inBand = math.abs(proj_s) <= effBand

// And make sure all signal logic uses proj_n consistently:
//farAbove = proj_s > (effBand + band_extra)
//farBelow = proj_s < -(effBand + band_extra)

