        table.cell(infoTable, 2, 3, str.tostring(consCount), text_color=divStrColor)
        table.cell(infoTable, 0, 4, "Volume", text_color=color.gray)
        volRatio = current_volume / avgVolume
        table.cell(infoTable, 1, 4, str.tostring(volRatio, "#.#") + "x")
        table.cell(infoTable, 2, 4, volSpike ? "🔥" : volExhaustion ? "💤" : "•", text_color=volSpike ? color.orange : volExhaustion ? color.blue : color.gray)
        table.cell(infoTable, 0, 5, "Ultra", text_color=color.gray)
        table.cell(infoTable, 1, 5, use_ultra_data ? "ON" : "OFF", text_color=use_ultra_data ? color.green : color.gray)
        table.cell(infoTable, 2, 5, market_type, text_color=color.white)
