shortCVDStrBonus = shortLiquid ? (bear_div_strength == "Very Strong" ? 15 : bear_div_strength == "Strong" ? 10 : 0) : 0

// Get signals from multiple timeframes
[tf_5min_bull, tf_5min_bear, tf_5min_roc] = request.security(syminfo.tickerid, "5",     [bullish_div, bearish_div, cvdRoC], lookahead=barmerge.lookahead_off)
    
[tf_15min_bull, tf_15min_bear, tf_15min_roc] = request.security(syminfo.tickerid, "15",     [bullish_div, bearish_div, cvdRoC], lookahead=barmerge.lookahead_off)

// Weight based on current timeframe
mtf_weight_bull = timeframe.isminutes ? (timeframe.multiplier <= 5 ? 0.7 :  timeframe.multiplier <= 30 ? 0.5 : 0.3) : 0.2             

mtf_weight_5min = timeframe.isminutes ?     (timeframe.multiplier <= 5 ? 0.2 : 0.3) : 0.3

mtf_weight_15min = timeframe.isminutes ?     (timeframe.multiplier <= 5 ? 0.1 : 0.2) : 0.5

// Confluence score
confluence_bull = (bullish_div ? mtf_weight_bull : 0) +                   (tf_5min_bull ? mtf_weight_5min : 0) +                   (tf_15min_bull ? mtf_weight_15min : 0)

confluence_bear = (bearish_div ? mtf_weight_bull : 0) +                   (tf_5min_bear ? mtf_weight_5min : 0) +                   (tf_15min_bear ? mtf_weight_15min : 0)

// === SCALPING GATES & BONUSES ===============================================
// Inputs
groupScalp = "Scalping/Execution"
useSweepReclaim      = input.bool(true,  "Require Sweep & Reclaim", group=groupScalp)
sweepTicks           = input.int(6,      "Sweep Size (ticks)", minval=1, group=groupScalp)
nearVWAPOnly         = input.bool(true,  "Only near Session VWAP Bands", group=groupScalp)
nearKeltnerOnly      = input.bool(false, "Only at Keltner Extremes", group=groupScalp)
noiseLookback        = input.int(20,     "Noise Filter Lookback", group=groupScalp)
noiseMult            = input.float(1.4,  "Min Range vs AvgTR", step=0.1, group=groupScalp)
allowOppositeBypass  = input.bool(true,  "Bypass Cooldown on Opposite Signal", group=groupScalp)
timeStopBars         = input.int(4,      "Time Stop (bars)", minval=2, group=groupScalp)
todWeighting         = input.bool(true,  "Use Time-of-Day Weighting", group=groupScalp)
lunchStart           = input.int(11*60+30, "Lunch Start (min from 00:00)", group=groupScalp)
lunchEnd             = input.int(13*60+30, "Lunch End (min from 00:00)",  group=groupScalp)


// Session-anchored vwap (resets with session)
ticks(n) => n * syminfo.mintick
var float sv_cumPV = na
var float sv_cumV  = na
if isNewSession or na(sv_cumPV) or na(sv_cumV)
    sv_cumPV := hlc3 * current_volume
    sv_cumV  := current_volume
else
    sv_cumPV += hlc3 * current_volume
    sv_cumV  += current_volume
sessionVWAP  = sv_cumV > 0 ? sv_cumPV / sv_cumV : na
sessionDev   = ta.stdev(close, vwapLookback)
svwapUpper   = sessionVWAP + sessionDev * vwapDeviation
svwapLower   = sessionVWAP - sessionDev * vwapDeviation
svwapUpper2  = sessionVWAP + sessionDev * vwapDeviation2
svwapLower2  = sessionVWAP - sessionDev * vwapDeviation2

// Impulse/noise — softer in Scalp mode
avgTR  = ta.sma(ta.tr, noiseLookback)
effNoiseMult = isScalpMode ? noiseMult * 0.8 : noiseMult
currTR = ta.tr
isImpulse = currTR > avgTR * effNoiseMult

// ToD weighting (keep light in Scalp)
minutesToday = hour * 60 + minute
todFactorBase = todWeighting ? (minutesToday >= lunchStart and minutesToday <= lunchEnd ? 1.15 : (minutesToday < 9*60+45 ? 0.90 : 1.00)) : 1.00
todFactor = isScalpMode ? 1.00 : todFactorBase

// Sweeps: slightly smaller in Scalp
sweepTicksEff = isScalpMode ? math.max(1, sweepTicks - 2) : sweepTicks
lastSwingHigh = ta.valuewhen(high_fractal, high[fractal_periods], 0)
lastSwingLow  = ta.valuewhen(low_fractal,  low[fractal_periods],  0)
sweepDown   = not na(lastSwingLow)  and low  < lastSwingLow  - ticks(sweepTicksEff)
reclaimUp   = sweepDown and close > lastSwingLow
sweepUp     = not na(lastSwingHigh) and high > lastSwingHigh + ticks(sweepTicksEff)
reclaimDown = sweepUp   and close < lastSwingHigh

nearSVWAPLong    = nearVWAPOnly    ? (low  <= svwapLower2 or low  <= svwapLower) : true
nearSVWAPShort   = nearVWAPOnly    ? (high >= svwapUpper2 or high >= svwapUpper) : true
nearKeltnerLong  = nearKeltnerOnly ? low  <= lowerKeltner : true
nearKeltnerShort = nearKeltnerOnly ? high >= upperKeltner : true

// Allow context ORs for scalping (VWAP OR sweep/div)
scalpContextLong  = nearSVWAPLong  or stopHuntLong  or (bullish_div and bull_phase_confirmed)
scalpContextShort = nearSVWAPShort or stopHuntShort or (bearish_div and bear_phase_confirmed)

// Gating
scalpGateLong  = (not useSweepReclaim or (sweepDown and reclaimUp))   and nearKeltnerLong  and isImpulse and (isScalpMode ? scalpContextLong  : nearSVWAPLong)
scalpGateShort = (not useSweepReclaim or (sweepUp   and reclaimDown)) and nearKeltnerShort and isImpulse and (isScalpMode ? scalpContextShort : nearSVWAPShort)

// Scalp bonuses
scalpSweepBonusLong  = (sweepDown  and reclaimUp)   ? 12 : 0
scalpSweepBonusShort = (sweepUp    and reclaimDown) ? 12 : 0
scalpVWAPBonusLong   = (low  <= svwapLower2 or low  <= svwapLower) ? 8 : 0
scalpVWAPBonusShort  = (high >= svwapUpper2 or high >= svwapUpper) ? 8 : 0

// === PCA Integration into Scoring ===
// Calculate PCA bonus (scaled by weight and strength)
pcaLongBonus = enablePCA and pca_long ? math.round(pca_strength_long * pcaWeight * 100) : 0
pcaShortBonus = enablePCA and pca_short ? math.round(pca_strength_short * pcaWeight * 100) : 0

// Enhanced scoring with PCA integration
longScore  = longVolumeScore + longVWAPScore + longRSIScore + longCVDDivScore +  longCVDStrBonus + (longMomentumExhaustion?30:0) + (longCVDMomentumDiv?25:0) + (low<=lowerKeltner?10:0) + (low<=vwapLower2?10:0) + htfAlignmentLong + stopHuntLongBonus + regimeBonus + scalpSweepBonusLong + scalpVWAPBonusLong +pattern_score_long + (bull_structure_break?25:0) + (confluence_bull*30) +(exhaustion_pattern and low < ta.lowest(low[1], 10) ? 20 : 0) + pcaLongBonus

shortScore = shortVolumeScore + shortVWAPScore + shortRSIScore + shortCVDDivScore + shortCVDStrBonus + (shortMomentumExhaustion?30:0) + (shortCVDMomentumDiv?25:0) + (high>=upperKeltner?10:0) + (high>=vwapUpper2?10:0) + htfAlignmentShort + stopHuntShortBonus + regimeBonus + scalpSweepBonusShort + scalpVWAPBonusShort +pattern_score_short + (bear_structure_break?25:0) + (confluence_bear*30) +(exhaustion_pattern and high > ta.highest(high[1], 10) ? 20 : 0) + pcaShortBonus

// Adjusted minimum score (lighter in Scalp)
float rawAdjMin = minConfirmScoreActual * regime_multiplier * todFactor
float adjustedMinScore = isScalpMode ? math.round(math.min(45, math.max(22, rawAdjMin - 8))) : math.round(rawAdjMin)

// Apply PCA regime adjustment (replaces old VIX term structure)
float enhanced_min_score_adjustment = vix_regime_multiplier * pcaWeight
float final_min_score_multiplier = 1.0 + (enhanced_min_score_adjustment - 1.0) * pcaWeight
float minScoreVIX = math.round(adjustedMinScore * final_min_score_multiplier)


// Cooldown (opposite-side bypass stays)
longCooldownOK  = (bar_index - lastLongSignalBar  >= signalCooldownActual) or (allowOppositeBypass and lastSide == -1)
shortCooldownOK = (bar_index - lastShortSignalBar >= signalCooldownActual) or (allowOppositeBypass and lastSide ==  1)

// Trigger counts & single-trigger relax for Scalp
longTriggerCount  = (longLiquid?1:0)  + (longMomentumExhaustion?1:0)  + (longCVDMomentumDiv?1:0)
shortTriggerCount = (shortLiquid?1:0) + (shortMomentumExhaustion?1:0) + (shortCVDMomentumDiv?1:0)
singleTriggerLong  = isScalpMode ? (longTriggerCount  >= 1) : (not requireSingleTrigger or longTriggerCount  == 1)
singleTriggerShort = isScalpMode ? (shortTriggerCount >= 1) : (not requireSingleTrigger or shortTriggerCount == 1)

// Final signals
baseLong  = (longLiquid or longMomentumExhaustion or longCVDMomentumDiv or stopHuntLong)
baseShort = (shortLiquid or shortMomentumExhaustion or shortCVDMomentumDiv or stopHuntShort)
highProbLong  = baseLong  and longScore  >= minScoreVIX and longCooldownOK  and (isScalpMode ? true : trendAlignmentLong)  and singleTriggerLong  and sessionTimeOK and scalpGateLong
highProbShort = baseShort and shortScore >= minScoreVIX and shortCooldownOK and (isScalpMode ? true : trendAlignmentShort) and singleTriggerShort and sessionTimeOK and scalpGateShort

// Update last signal bars & side
if highProbLong
    lastLongSignalBar := bar_index
    lastSide := 1
if highProbShort
    lastShortSignalBar := bar_index
    lastSide := -1

// === Plotting (unchanged visuals + session VWAP bands) ===
barcolor(highlightCandles and array.includes(longBars, 0)  and barstate.isconfirmed ? color.new(color.red, 30)  : na)
barcolor(highlightCandles and array.includes(shortBars, 0) and barstate.isconfirmed ? color.new(color.lime, 30) : na)
plot(showCVD and barstate.isconfirmed ? cvdSmooth : na, title="CVD Smooth", color=color.new(color.blue, 0), linewidth=2)
plot(useKeltner and barstate.isconfirmed ? upperKeltner : na, "Upper Keltner", color=color.new(color.orange, 70), linewidth=1)
plot(useKeltner and barstate.isconfirmed ? lowerKeltner : na, "Lower Keltner", color=color.new(color.orange, 70), linewidth=1)
plot(useKeltner and barstate.isconfirmed ? basis        : na, "Keltner Basis",  color=color.new(color.orange, 85), linewidth=1)
plot(useSecondVWAP and barstate.isconfirmed ? vwapUpper2 : na, "VWAP Upper 2", color=color.new(color.purple, 70), linewidth=1)
plot(useSecondVWAP and barstate.isconfirmed ? vwapLower2 : na, "VWAP Lower 2", color=color.new(color.purple, 70), linewidth=1)
plot(nearVWAPOnly and barstate.isconfirmed ? svwapUpper  : na, "Sess VWAP Upper",  color=color.new(color.teal, 70))
plot(nearVWAPOnly and barstate.isconfirmed ? svwapLower  : na, "Sess VWAP Lower",  color=color.new(color.teal, 70))
plot(nearVWAPOnly and useSecondVWAP and barstate.isconfirmed ? svwapUpper2 : na, "Sess VWAP Upper2", color=color.new(color.teal, 80))
plot(nearVWAPOnly and useSecondVWAP and barstate.isconfirmed ? svwapLower2 : na, "Sess VWAP Lower2", color=color.new(color.teal, 80))
bgcolor(useCVDRoC and cvdRoC >  dynamic_cvd_roc_threshold and barstate.isconfirmed ? color.new(color.red, 90)   : na)
bgcolor(useCVDRoC and cvdRoC < -dynamic_cvd_roc_threshold and barstate.isconfirmed ? color.new(color.green, 90) : na)
plotshape(showCVDDivergence and bullish_div and bull_phase_confirmed and barstate.isconfirmed, title="CVD Bull Div", style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal)
plotshape(showCVDDivergence and bearish_div and bear_phase_confirmed and barstate.isconfirmed, title="CVD Bear Div", style=shape.triangledown, location=location.abovebar,  color=color.red,   size=size.normal)
plotshape(showPCAMarkers and enablePCA and pca_long and barstate.isconfirmed, title="PCA Long", style=shape.circle, location=location.belowbar, color=color.aqua, size=size.tiny, text="P")
plotshape(showPCAMarkers and enablePCA and pca_short and barstate.isconfirmed, title="PCA Short", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny, text="P")
plotchar(highProbLong  and barstate.isconfirmed,  title="High Prob Long",  char="●", location=location.belowbar, color=color.green, size=size.normal)
plotchar(highProbShort and barstate.isconfirmed,  title="High Prob Short", char="●", location=location.abovebar,  color=color.red,   size=size.normal)

// === Risk levels (unchanged, with tick option) ===
calculate_levels(is_long)=>
    atr_stop = useHTF ? htf_atr * 1.5 : atr * 1.5
    if is_long
        [low - atr_stop, close + atr_stop, close + atr_stop*2, close + atr_stop*3]
    else
        [high + atr_stop, close - atr_stop, close - atr_stop*2, close - atr_stop*3]




if highProbLong and showLabels and barstate.isconfirmed
    signalType = longLiquid ? "LIQ" : longMomentumExhaustion ? "MOM" : "MULTI"
    lt = "▲ LONG \n" + signalType + "\n" + str.tostring(longScore) + "%"
    if showDivStrength and bull_div_strength != "None"
        lt += "\n" + bull_div_strength + " Div"
    label.new(bar_index, low * 0.99975, text=lt, color=color.new(color.green, 90), textcolor=color.green, style=label.style_label_up, size=size.small)

if highProbShort and showLabels and barstate.isconfirmed
    signalType = shortLiquid ? "LIQ" : shortMomentumExhaustion ? "MOM" : "MULTI"
    lt = "SHORT ▼\n" + signalType + "\n" + str.tostring(shortScore) + "%"
    if showDivStrength and bear_div_strength != "None"
        lt += "\n" + bear_div_strength + " Div"
    label.new(bar_index, high * 1.00075, text=lt, color=color.new(color.red, 90), textcolor=color.red, style=label.style_label_down, size=size.small)

// Alerts
alertcondition(highProbLong,  title="High Probability Long",  message="Liquidation Cascade Long Signal")
alertcondition(highProbShort, title="High Probability Short", message="Liquidation Cascade Short Signal")

// Zones
bgcolor(showZones and highProbLong  and barstate.isconfirmed ? color.new(color.green, 90) : na)
bgcolor(showZones and highProbShort and barstate.isconfirmed ? color.new(color.red,   90) : na)

// === Info Table ===
if showTable
    if barstate.islast and hasEnoughData
        table.merge_cells(infoTable, 0, 0, 2, 0)
        table.cell(infoTable, 0, 0, "LIQUIDATION DETECTOR", text_color=color.white, text_size=size.normal)
