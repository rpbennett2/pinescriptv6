        table.cell(infoTable, 2, 6, rsi > 70 ? "OB" : rsi < 30 ? "OS" : "N", text_color=rsiColor)
        table.cell(infoTable, 0, 7, "ATR", text_color=color.gray)
        table.cell(infoTable, 1, 7, str.tostring(atr, "#.##"))
        table.cell(infoTable, 2, 7, str.tostring((high-low)/atr, "#.#") + "x")
        table.merge_cells(infoTable, 0, 8, 2, 8)
