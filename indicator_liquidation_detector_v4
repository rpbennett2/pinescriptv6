// Volatility-Based Threshold Calculation
calculate_dynamic_thresholds() =>
    // Base volatility measures
    atr_volatility = ta.atr(14)
    price_volatility = ta.stdev(ta.roc(close, 1), volatilityLookback)
    volume_volatility = ta.stdev(ta.roc(volume, 1), volatilityLookback)
    
    // Normalize volatilities (0-1 scale)
    atr_normalized = atr_volatility / ta.sma(atr_volatility, volatilityLookback)
    price_vol_normalized = price_volatility / ta.sma(price_volatility, volatilityLookback)
    
    // Composite volatility score
    composite_volatility = (atr_normalized * 0.4 + price_vol_normalized * 0.6)
    
    // Market regime multiplier
    [diPlus, diMinus, adxValue] = ta.dmi(14, 14)
    [bb_upper, bb_basis, bb_lower] = ta.bb(close, 20, 2)
    bb_width_ratio = (bb_upper - bb_lower) / bb_basis / ta.sma((bb_upper - bb_lower) / bb_basis, 50)
    
    regime_multiplier = switch
        adxValue > 25 and bb_width_ratio > 1.2 => 1.4  // Trending volatile
        adxValue > 25 => 1.1                            // Trending smooth  
        bb_width_ratio > 1.2 => 0.9                     // Ranging volatile
        => 0.7                                           // Ranging tight
    
    // Time-of-day adjustment
    hour_adjustment = switch hour
        9 => 1.2   // Market open
        10 => 1.1  // Early session
        15 => 1.2  // Late session  
        16 => 1.3  // Market close
        => 1.0     // Regular hours
    
    // Final dynamic threshold
    base_threshold = 1 //baseThresholdMultiplier
    dynamic_factor = composite_volatility * regime_multiplier * hour_adjustment
    
    [base_threshold * dynamic_factor, composite_volatility, regime_multiplier]

// Adaptive threshold variables with exponential smoothing
var float adaptive_cvd_threshold = 1.0
var float adaptive_volume_threshold = 3.0
var float adaptive_momentum_threshold = 2.0

[current_threshold_multiplier, volatility_score, regime_mult] = calculate_dynamic_thresholds()

if useDynamicThresholds
    // Smooth adaptation to prevent whipsawing
    atr_percentile = ta.percentrank(atr, 100)
    sensitivity_mult = atr_percentile > 80 ? 0.7 : atr_percentile < 20 ? 1.3 : 1.0
    
    adaptive_cvd_threshold := adaptive_cvd_threshold + (current_threshold_multiplier * 1.0 - adaptive_cvd_threshold) * adaptationSpeed
    adaptive_volume_threshold := adaptive_volume_threshold + (current_threshold_multiplier * 3.0 - adaptive_volume_threshold) * adaptationSpeed  
    adaptive_momentum_threshold := adaptive_momentum_threshold + (current_threshold_multiplier * 2.0 * sensitivity_mult - adaptive_momentum_threshold) * adaptationSpeed
else
    // Use static thresholds from original implementation
    adaptive_cvd_threshold := cvdDivThreshold
    adaptive_volume_threshold := volumeMultiplier
    adaptive_momentum_threshold := momentumThreshold

