        table.cell(infoTable, 0, 9, "Range", text_color=color.gray)
        table.cell(infoTable, 1, 9, isLargeRange(0) ? "Large" : "Normal")
        table.cell(infoTable, 2, 9, isLargeRange(0) ? "✓" : "✗", text_color=isLargeRange(0) ? color.green : color.gray)
        table.cell(infoTable, 0, 10, "Pattern", text_color=color.gray)
        patternText = longLiquid ? "Bear Liq" : shortLiquid ? "Bull Liq" : "None"
        patternColor = longLiquid ? color.red : shortLiquid ? color.green : color.gray
        table.cell(infoTable, 1, 10, patternText, text_color=patternColor)
