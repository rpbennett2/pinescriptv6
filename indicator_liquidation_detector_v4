// Helper functions for PCA
f_clamp(x, lo, hi) => x < lo ? lo : x > hi ? hi : x

f_robust_z(src, n) =>
    m = ta.median(src, n)
    mad = ta.median(math.abs(src - m), n)
    z = (mad == 0) ? 0 : (src - m) / (mad * 1.4826)
    f_clamp(z, -6.0, 6.0)

f_z_ratio(num, den, n) =>
    v = (den != 0) ? (num/den - 1.0) : na
    v := f_clamp(nz(v), -0.35, 0.35)
    f_robust_z(v, n)

calculate_pca_projection() =>
    if not enablePCA
        [0.0, 0.0, 0.0, 0, "Unknown", 1.0]
    else
        // Fetch market internals and VIX data
        tck = request.security(symTick, pcaDataTF, close, lookahead=barmerge.lookahead_off)
        add = request.security(symAdd, pcaDataTF, close, lookahead=barmerge.lookahead_off)
        vold = request.security(symVold, pcaDataTF, close, lookahead=barmerge.lookahead_off)
        vx1 = request.security(symVX1, pcaVxTF, close, lookahead=barmerge.lookahead_off)
        vx2 = request.security(symVX2, pcaVxTF, close, lookahead=barmerge.lookahead_off)
        vx3 = request.security(symVX3, pcaVxTF, close, lookahead=barmerge.lookahead_off)
        v9d = request.security(symVIX9D, pcaVxTF, close, lookahead=barmerge.lookahead_off)

        // Create standardized features
        z1 = f_robust_z(tck, pcaWindow)
        z2 = f_robust_z(add, pcaWindow)
        z3 = f_robust_z(vold, pcaWindow)
        z4 = f_z_ratio(vx2, vx1, pcaWindow)
        z5 = f_z_ratio(vx3, vx1, pcaWindow)
        z6 = f_z_ratio(vx1, v9d, pcaWindow)

        // Apply weights to term structure features
        z4w = w_m2m1 * z4
        z6w = w_short * z6

        arr = array.from(z1, z2, z3, z4w, z5, z6w)

        // Compute correlation matrix and PCA
        corr = matrix.new<float>(6, 6, 0.0)
        for i = 0 to 5
            for j = 0 to 5
                cij = ta.correlation(array.get(arr, i), array.get(arr, j), pcaWindow)
                matrix.set(corr, i, j, nz(cij))

        eigVal = corr.eigenvalues()
        eigVec = corr.eigenvectors()

        // Sign consistency for PC1
        var array<float> pc_prev = array.new<float>(6, 0.0)
        var bool pc_init = false

        f_dot(a, b) =>
            a.get(0)*b.get(0) + a.get(1)*b.get(1) + a.get(2)*b.get(2) +
            a.get(3)*b.get(3) + a.get(4)*b.get(4) + a.get(5)*b.get(5)

        pc_now = eigVec.col(0)
        same_dir = not pc_init or (f_dot(pc_now, pc_prev) >= 0)

        f_mult(arrF, k) =>
            r = array.new<float>(array.size(arrF))
            for i = 0 to array.size(arrF) - 1
                array.set(r, i, arrF.get(i) * k)
            r

        pc_aligned = same_dir ? pc_now : f_mult(pc_now, -1.0)

        for i = 0 to 5
            array.set(pc_prev, i, pc_aligned.get(i))
        pc_init := true

        // Calculate projection
        proj_raw = array.get(arr, 0) * pc_aligned.get(0) +
                   array.get(arr, 1) * pc_aligned.get(1) +
                   array.get(arr, 2) * pc_aligned.get(2) +
                   array.get(arr, 3) * pc_aligned.get(3) +
                   array.get(arr, 4) * pc_aligned.get(4) +
                   array.get(arr, 5) * pc_aligned.get(5)

        // Normalize by eigenvalue
        ev1 = math.max(eigVal.get(0), 1e-9)
        proj_n = f_clamp(proj_raw / math.sqrt(ev1), -6.0, 6.0)

        // Smooth projection
        proj_s = ta.ema(proj_n, pcaProjSmooth)
        fast_ema = ta.ema(proj_s, pcaFastLen)
        slow_ema = ta.ema(proj_s, pcaSlowLen)

        // VIX regime analysis
        m2m1 = na(vx1) or na(vx2) ? na : (vx2 / vx1 - 1.0)
        m3m1 = na(vx3) or na(vx1) ? na : (vx3 / vx1 - 1.0)

        vix_regime = if na(m2m1)
            0  // Default to Normal if data unavailable
        else
            switch
                m2m1 < -0.06 => -2    // Deep backwardation
                m2m1 < -0.015 => -1   // Backwardation
                m2m1 > 0.06 => 2      // Steep contango
                m2m1 > 0.015 => 1     // Contango
                => 0                   // Flat

        risk_regime = switch vix_regime
            -2 => "Crisis"
            -1 => "Stress"
            0 => "Normal"
            1 => "Elevated"
            2 => "Complacent"
            => "Unknown"

        regime_adjustment = switch vix_regime
            -2 => 0.7
            -1 => 0.85
            0 => 1.0
            1 => 1.15
            2 => 1.25
            => 1.0

        [proj_s, fast_ema, slow_ema, vix_regime, risk_regime, regime_adjustment]

