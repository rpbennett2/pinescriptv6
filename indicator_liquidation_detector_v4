// Generate liquidation signals based on PCA projection
generate_pca_signals() =>
    bool longSignal = false
    bool shortSignal = false
    float strengthLong = 0.0
    float strengthShort = 0.0

    if enablePCA
        // Calculate thresholds
        sigProj = 1.0  // Normalized projection has unit variance
        effBand = math.max(0.12 * sigProj, pcaBandK * sigProj * vix_regime_multiplier)
        min_spread = pcaSpreadK * sigProj * vix_regime_multiplier
        band_extra = 0.15 * sigProj

        // Signal conditions
        farAbove = pca_projection > (effBand + band_extra)
        farBelow = pca_projection < -(effBand + band_extra)
        spreadUp = (pca_fast - pca_slow) > min_spread
        spreadDn = (pca_slow - pca_fast) > min_spread

        // Generate signals
        pca_long_signal = farAbove and spreadUp
        pca_short_signal = farBelow and spreadDn

        // Calculate signal strength
        pca_strength = math.abs(pca_projection) / sigProj
        regime_strength = vix_regime_multiplier < 1.0 ? 1.3 : 0.8

        longSignal := pca_long_signal
        shortSignal := pca_short_signal
        strengthLong := pca_long_signal ? (pca_strength * 0.65 + regime_strength * 0.35) : 0.0
        strengthShort := pca_short_signal ? (pca_strength * 0.65 + regime_strength * 0.35) : 0.0

    [longSignal, shortSignal, strengthLong, strengthShort]

