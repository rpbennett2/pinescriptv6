        time_condition = (last_high_bar + max_bars_between) > bar_index
        bars_valid = bars_between >= min_bars_between and bars_between <= max_bars_between
        price_change = (last_high_price - prev_high_price) / prev_high_price * 100
        cvd_change   = (last_high_cvd - prev_high_cvd) / math.abs(prev_high_cvd) * 100
        price_higher = price_change > (0.1 / divergence_sensitivity)
