        table.cell(infoTable, 1, 11, str.tostring(currentScore) + "%", text_color=scoreColor)
        table.cell(infoTable, 2, 11, currentScore >= minConfirmScoreActual ? "🎯" : currentScore > 0 ? "⚡" : "•", text_color=scoreColor)
