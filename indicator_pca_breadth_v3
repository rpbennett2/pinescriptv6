// PCA Breadth Composite — Enhanced v2.1 (Refined Signals - Less Noise)
//@version=6
indicator("PCA-BC Enhanced v2.1", shorttitle="PCA-BC Enhanced v2.1", overlay=false, dynamic_requests=true)
import TradingView/ta/10

// ── Profile / Parameters
profile     = input.string("Auto", "Intraday Profile", options=["Auto","1m","5m","15m"])
matchChart  = input.bool(false, "Match Chart TF for data/VX/VIX")
showTable   = input.bool(true, "Show Info Table", group="Display Settings")

is1  = timeframe.isminutes and timeframe.multiplier == 1
is5  = timeframe.isminutes and timeframe.multiplier == 5
is15 = timeframe.isminutes and timeframe.multiplier == 15
resolved = profile == "Auto" ? (is1 ? "1m" : is5 ? "5m" : is15 ? "15m" : "5m") : profile

// Selectivity controls
proj_smooth_len = input.int(5, "Proj Smoothing (EMA)", minval=1)
spread_k_sigma  = input.float(0.18, "Min EMA-Spread (k·σ_proj)", step=0.01)
band_extra_k    = input.float(0.15, "Extra Distance from Band (k·σ_proj)", step=0.01)
N_hold          = input.int(3, "Bars to Hold Condition", minval=1, maxval=10)
N_cool          = input.int(15, "Cooldown Bars After Flip", minval=0, maxval=200)

// Correct TF mapping
string _data_tf = resolved == "1m" ? "1"  : resolved == "5m" ? "5"  : "15"
string _vx_tf   = resolved == "1m" ? "2"  : resolved == "5m" ? "5"  : "10"
string _vix_tf  = resolved == "1m" ? "5"  : "15"

string data_tf = matchChart ? timeframe.period : _data_tf
string vx_tf   = matchChart ? timeframe.period : _vx_tf
string vix_tf  = matchChart ? timeframe.period : _vix_tf

// Windows tuned to 1m/5m/15m
int pca_window = resolved == "1m" ? 240 : resolved == "5m" ? 96 : 64
int fast_len   = resolved == "1m" ? 14  : resolved == "5m" ? 9  : 5
int slow_len   = resolved == "1m" ? 40  : resolved == "5m" ? 21 : 12

regime_lookback = input.int(365, "Regime Lookback")
w_m2m1  = input.float(1.50, "Weight: M2/M1",          step=0.1)
w_short = input.float(0.50, "Weight: VX1 vs VIX9D",   step=0.1)

// Band settings
sigLen   = input.int(100, "Sigma Len (proj)")
bandK    = input.float(0.25, "Base No-Trade Band (k·σ)", step=0.01)
bandMin  = input.float(0.12, "Band Floor (k·σ min)",     step=0.01)
rthOnly  = input.bool(true, "Only trade RTH (0630–1500 CT)")
m3_mode  = input.string("Manual", "M3 Source", options = ["Manual","VIX3M Proxy","Off"])

// ── Symbols
symTick = input.symbol("USI:TICK", "TICK")
symAdd  = input.symbol("USI:ADD",  "ADD")
symVold = input.symbol("USI:VOLD", "VOLD")
symVX1  = input.symbol("CBOE:VX1!", "VX1!")
symVX2  = input.symbol("CBOE:VX2!", "VX2!")
symVX3_manual = input.symbol("CBOE:VXZ2025", "VX M3 (manual)")
symVIX    = input.symbol("CBOE:VIX",   "VIX")
symVIX3M  = input.symbol("CBOE:VIX3M", "VIX3M")
symVIX9D  = input.symbol("CBOE:VIX9D", "VIX9D")

// CVD Configuration
groupCVD = "CVD Volume Analysis"
enableCVD = input.bool(true, "Enable CVD Analysis", group=groupCVD)
cvdSmoothPeriod = input.int(8, "CVD Smoothing Period", minval=1, maxval=20, group=groupCVD)
cvdDivThreshold = input.float(2.0, "CVD Divergence Threshold (ATR)", minval=0.5, step=0.1, group=groupCVD)
cvdWeight = input.float(0.20, "CVD Signal Weight", minval=0.0, maxval=1.0, step=0.05, group=groupCVD)
cvdMinBars = input.int(15, "Min Bars Between CVD Signals", minval=5, maxval=50, group=groupCVD)

// CVD timeframe settings
cvdLowerTF = "1"
cvdCumulativePeriod = "D"
[vd_open, vd_high, vd_low, vd_current] =  ta.requestVolumeDelta(cvdLowerTF, cvdCumulativePeriod)
cvdRaw = vd_current
avg_volume = ta.sma(volume, 50)
cvdNormalized = avg_volume > 0 ? cvdRaw / avg_volume : 0.0
cvdClamped = math.max(math.min(cvdNormalized, 1000.0), -1000.0)
cvdSmooth = ta.ema(cvdClamped, cvdSmoothPeriod)
cvdMomentum = ta.roc(cvdSmooth, 10)
cvdAtr = math.max(ta.stdev(cvdSmooth, 14), 0.1)

// CVD Divergence Detection
var int lastCvdBullBar = 0
var int lastCvdBearBar = 0

detect_cvd_divergence() =>
    cvd_cooldown_ok = bar_index - math.max(lastCvdBullBar, lastCvdBearBar) >= cvdMinBars

    if not cvd_cooldown_ok
        [false, false]
    else
        lookback_bars = 20
        price_decline = (low - ta.lowest(low[1], lookback_bars)) / ta.lowest(low[1], lookback_bars)
        cvd_improvement = (cvdSmooth - ta.lowest(cvdSmooth[1], lookback_bars)) / math.abs(ta.lowest(cvdSmooth[1], lookback_bars))
        price_rise = (high - ta.highest(high[1], lookback_bars)) / ta.highest(high[1], lookback_bars)
        cvd_deterioration = (ta.highest(cvdSmooth[1], lookback_bars) - cvdSmooth) / math.abs(ta.highest(cvdSmooth[1], lookback_bars))

        bullish_div = price_decline < -0.02 and cvd_improvement > 0.15 and math.abs(cvdMomentum) > cvdDivThreshold
        bearish_div = price_rise > 0.02 and cvd_deterioration > 0.15 and math.abs(cvdMomentum) > cvdDivThreshold

        [bullish_div, bearish_div]

[cvd_bull_div_raw, cvd_bear_div_raw] = detect_cvd_divergence()

if cvd_bull_div_raw
    lastCvdBullBar := bar_index
if cvd_bear_div_raw
    lastCvdBearBar := bar_index

cvd_bull_div = cvd_bull_div_raw
cvd_bear_div = cvd_bear_div_raw
cvd_signal_strength = enableCVD ? math.min(math.abs(cvdMomentum) / cvdAtr, 2.0) : 0.0

// ── Fetch original data
tck  = request.security(symTick, data_tf, close)
add  = request.security(symAdd,  data_tf, close)
vold = request.security(symVold, data_tf, close)
vx1  = request.security(symVX1,  vx_tf,   close)
vx2  = request.security(symVX2,  vx_tf,   close)
vx3  = m3_mode == "Manual"       ? request.security(symVX3_manual, vx_tf, close) : na
vix  = m3_mode == "VIX3M Proxy"  ? request.security(symVIX,        vix_tf, close) : na
vix3 = m3_mode == "VIX3M Proxy"  ? request.security(symVIX3M,      vix_tf, close) : na
v9d  = request.security(symVIX9D, vix_tf, close)

// ── Helpers
f_clamp(x, lo, hi) => x < lo ? lo : x > hi ? hi : x
f_robust_z(src, n) =>
    m   = ta.median(src, n)
    mad = ta.median(math.abs(src - m), n)
    z   = (mad == 0) ? 0 : (src - m) / (mad * 1.4826)
    f_clamp(z, -6.0, 6.0)
f_z_ratio(num, den, n) =>
    v = (den != 0) ? (num/den - 1.0) : na
    v := f_clamp(nz(v), -0.35, 0.35)   // tighter winsorize for 5m A/B
    f_robust_z(v, n)
f_trend(f, s) => na(f) or na(s) ? "n/a" : f > s ? "Up" : f < s ? "Down" : "Flat"

// ── Features
z1 = f_robust_z(tck,  pca_window)
z2 = f_robust_z(add,  pca_window)
z3 = f_robust_z(vold, pca_window)
z4 = f_z_ratio(vx2, vx1, pca_window)
z5 = m3_mode == "Manual" ? f_z_ratio(vx3, vx1, pca_window) :
     m3_mode == "VIX3M Proxy" ? f_z_ratio(vix3, vix, pca_window) : 0.0
z6 = f_z_ratio(vx1, v9d, pca_window)

z4w = w_m2m1  * z4
z6w = w_short * z6
arr = array.from(z1, z2, z3, z4w, z5, z6w)

// ── Correlation PCA (6×6) + sign lock
corr = matrix.new<float>(6,6,0.0)
for i=0 to 5
    for j=0 to 5
        cij = ta.correlation(array.get(arr,i), array.get(arr,j), pca_window)
        matrix.set(corr, i, j, nz(cij))
eigVal = corr.eigenvalues()
eigVec = corr.eigenvectors()

var bool pc_prev_init = false
var array<float> pc_prev = array.new<float>(6, 0.0)
f_dot(a, b) => a.get(0)*b.get(0)+a.get(1)*b.get(1)+a.get(2)*b.get(2)+a.get(3)*b.get(3)+a.get(4)*b.get(4)+a.get(5)*b.get(5)
f_mult(arrF, k) =>
    r = array.new<float>(array.size(arrF))
    for i=0 to array.size(arrF)-1
        array.set(r, i, arrF.get(i)*k)
    r
pc_now = eigVec.col(0)
same_dir = not pc_prev_init or (f_dot(pc_now, pc_prev) >= 0)
pc_aligned = same_dir ? pc_now : f_mult(pc_now, -1.0)
for i=0 to 5
    array.set(pc_prev, i, pc_aligned.get(i))
pc_prev_init := true

proj = array.get(arr,0)*pc_aligned.get(0) + array.get(arr,1)*pc_aligned.get(1) + array.get(arr,2)*pc_aligned.get(2) + array.get(arr,3)*pc_aligned.get(3) + array.get(arr,4)*pc_aligned.get(4) + array.get(arr,5)*pc_aligned.get(5)

// Normalize projection to unit variance using PC1 eigenvalue
ev1 = math.max(eigVal.get(0), 1e-9)
proj_n = proj / math.sqrt(ev1)

// (optional) clip for plotting aesthetic
proj_n := f_clamp(proj_n, -6.0, 6.0)

// Use proj_n for everything below instead of proj
proj_s = ta.ema(proj_n, proj_smooth_len)
fast   = ta.ema(proj_s, fast_len)
slow   = ta.ema(proj_s, slow_len)

// If you normalize, σ(proj_n) ≈ 1 → replace sigProj with 1 for thresholds:
sigProj = 1.0

// Dynamic Threshold Configuration
groupDynamic = "Dynamic Thresholds"
useDynamicThresholds = input.bool(true, "Enable Dynamic Thresholds", group=groupDynamic)
baseThresholdMultiplier = input.float(1.1, "Base Threshold Multiplier", minval=0.5, maxval=2.0, step=0.1, group=groupDynamic)
volatilityLookback = input.int(75, "Volatility Lookback", minval=20, maxval=200, group=groupDynamic)
adaptationSpeed = input.float(0.08, "Adaptation Speed", minval=0.01, maxval=0.5, step=0.01, group=groupDynamic)

// Volatility-based threshold calculation
calculate_dynamic_thresholds() =>
    proj_volatility = ta.stdev(proj_s, volatilityLookback)

    proj_vol_sma = ta.sma(proj_volatility, volatilityLookback)
    proj_vol_normalized = proj_vol_sma > 0 ? proj_volatility / proj_vol_sma : 1.0

    hour_adjustment = switch hour
        9 => 1.3
        10 => 1.15
        15 => 1.2
        16 => 1.4
        => 1.0

    dynamic_factor = proj_vol_normalized * hour_adjustment
    result = baseThresholdMultiplier * dynamic_factor
    na(result) ? baseThresholdMultiplier : result
 

var float adaptive_band_threshold = 0.20
var float adaptive_spread_threshold = 0.15
current_threshold_multiplier = calculate_dynamic_thresholds()

if useDynamicThresholds
    target_band = current_threshold_multiplier * 0.20
    target_spread = current_threshold_multiplier * 0.15

    adaptive_band_threshold := adaptive_band_threshold + (target_band - adaptive_band_threshold) * adaptationSpeed
    adaptive_spread_threshold := adaptive_spread_threshold + (target_spread - adaptive_spread_threshold) * adaptationSpeed
else
    adaptive_band_threshold := bandK
    adaptive_spread_threshold := spread_k_sigma

// steadier regime scaling: EMA( conc, 50 ) and clamp
totVar = array.sum(eigVal)
conc   = totVar > 0 ? eigVal.get(0)/totVar : na
conc_s = ta.ema(conc, 50)
effK    = f_clamp(bandK * (1 - nz(conc_s)), 0.6*bandK, bandK)

// RTH gate
f_inSession(sess) => not na(time(timeframe.period, sess))
inRTH = (not rthOnly) or f_inSession("0630-1500:1234567")

// Term-structure calculations
f_pct(x) => na(x) ? "n/a" : str.tostring(math.round(x * 10000.0) / 100.0) + "%"
m2m1 = na(vx1) or na(vx2) ? na : (vx2 / vx1 - 1.0)
m3m1 = m3_mode == "Manual"  ? (na(vx3) or na(vx1) ? na : (vx3 / vx1 - 1.0))
      : m3_mode == "VIX3M Proxy" ? (na(vix3) or na(vix) ? na : (vix3 / vix - 1.0)) : na
shortSlope = na(vx1) or na(v9d) ? na : (vx1 / v9d - 1.0)
tsLabel = na(m2m1) ? "n/a" : m2m1 > 0 ? "Contango" : m2m1 < 0 ? "Backwardation" : "Flat"
tsColor = na(m2m1) ? color.gray : m2m1 > 0 ? color.new(color.green, 0) : color.new(color.red, 0)

// Enhanced VIX Regime Configuration
groupVixEnhanced = "Enhanced VIX Regime"
useEnhancedVixFiltering = input.bool(true, "Enable Enhanced VIX Filtering", group=groupVixEnhanced)
vixRegimeWeight = input.float(0.12, "VIX Regime Signal Weight", minval=0.0, maxval=0.5, step=0.01, group=groupVixEnhanced)
analyze_vix_regime() =>
    if not useEnhancedVixFiltering or na(m2m1)
        [0, "Unknown", 1.0]
    else
        front_slope = m2m1
        steep_threshold = 0.06
        flat_threshold = 0.015

        vix_regime = switch
            front_slope < -steep_threshold => -2
            front_slope < -flat_threshold => -1
            front_slope > steep_threshold => 2
            front_slope > flat_threshold => 1
            => 0

        risk_regime = switch vix_regime
            -2 => "Crisis"
            -1 => "Stress"
            0 => "Normal"
            1 => "Elevated"
            2 => "Complacent"
            => "Unknown"

        regime_adjustment = switch vix_regime
            -2 => 0.7
            -1 => 0.85
            0 => 1.0
            1 => 1.15
            2 => 1.25
            => 1.0

        [vix_regime, risk_regime, regime_adjustment]

[vix_ts_regime, vix_risk_regime, vix_regime_multiplier] = analyze_vix_regime()

// Apply VIX regime adjustment to thresholds
enhanced_band_threshold = adaptive_band_threshold * vix_regime_multiplier
enhanced_spread_threshold = adaptive_spread_threshold * vix_regime_multiplier

effBand = math.max(bandMin*sigProj, enhanced_band_threshold*sigProj)
min_spread = enhanced_spread_threshold * sigProj
band_extra = band_extra_k * sigProj

farAbove  = proj_s >  (effBand + band_extra)
farBelow  = proj_s < -(effBand + band_extra)
spreadUp  = (fast - slow) >  min_spread
spreadDn  = (slow - fast) >  min_spread

cvd_supportive_long = not enableCVD or cvdMomentum >= 0.0
cvd_supportive_short = not enableCVD or cvdMomentum <= 0.0

wantLong = inRTH and farAbove and spreadUp and cvd_supportive_long
wantShort= inRTH and farBelow and spreadDn and cvd_supportive_short

// Signal strength calculation
pca_strength = math.abs(proj_s) / sigProj
cvd_strength = enableCVD ? math.min(cvd_signal_strength, 1.5) : 0.5
regime_strength = vix_regime_multiplier < 1.0 ? 1.3 : 0.8
signal_strength = pca_strength * 0.65 + cvd_strength * cvdWeight + regime_strength * vixRegimeWeight

signal_strength_long = wantLong ? signal_strength : 0.0
signal_strength_short = wantShort ? signal_strength : 0.0

var int holdUp   = 0
var int holdDn   = 0
var int cooldown = 0
var int dir      = 0

holdUp  := wantLong  ? math.min(holdUp + 1, 1000) : 0
holdDn  := wantShort ? math.min(holdDn + 1, 1000) : 0
cooldown:= math.max(cooldown - 1, 0)

flipLong  = cooldown == 0 and holdUp  >= N_hold and dir <= 0
flipShort = cooldown == 0 and holdDn  >= N_hold and dir >= 0

if flipLong
    dir := 1
    cooldown := N_cool
else if flipShort
    dir := -1
    cooldown := N_cool

longEvent  = flipLong
shortEvent = flipShort
inLong = dir == 1
inShort= dir == -1
inBand = math.abs(proj_s) <= effBand

// Debug Table
showDebugTable = input.bool(true, "Show Debug Table", group="Display Settings")
var debugTable = table.new(position.middle_left, 2, 30, border_width=1, frame_color=color.new(color.yellow, 50))

if barstate.islast and showDebugTable
    row = 0

    table.cell(debugTable, 0, row, "DEBUG VARIABLE", text_color=color.yellow, bgcolor=color.new(color.black,0))
    table.cell(debugTable, 1, row, "VALUE", text_color=color.yellow, bgcolor=color.new(color.black,0))
    row += 1

    table.cell(debugTable, 0, row, "--- PROJECTIONS ---", text_color=color.black, bgcolor=color.new(color.lime,0))
    table.cell(debugTable, 1, row, "", bgcolor=color.new(color.lime,0))
    row += 1
    
    table.cell(debugTable, 0, row, "proj (raw)", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(proj, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "proj_n (normalized)", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(proj_n, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "proj_s (smoothed)", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(proj_s, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "fast", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(fast, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "slow", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(slow, "#.####"), text_color=color.white)
    row += 1

    table.cell(debugTable, 0, row, "--- SIGMA/BANDS ---", text_color=color.black, bgcolor=color.new(color.aqua,0))
    table.cell(debugTable, 1, row, "", bgcolor=color.new(color.aqua,0))
    row += 1
    
    table.cell(debugTable, 0, row, "sigProj", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(sigProj, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "bandK", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(bandK, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "bandMin", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(bandMin, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "effK", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(effK, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "effBand", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(effBand, "#.####"), text_color=color.white)
    row += 1

    table.cell(debugTable, 0, row, "--- DYNAMIC THRESH ---", text_color=color.black, bgcolor=color.new(color.orange,0))
    table.cell(debugTable, 1, row, "", bgcolor=color.new(color.orange,0))
    row += 1
    
    table.cell(debugTable, 0, row, "current_threshold_mult", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(current_threshold_multiplier, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "adaptive_band_thresh", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(adaptive_band_threshold, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "adaptive_spread_thresh", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(adaptive_spread_threshold, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "vix_regime_mult", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(vix_regime_multiplier, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "enhanced_band_thresh", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(enhanced_band_threshold, "#.####"), text_color=color.white)
    row += 1
    
    table.cell(debugTable, 0, row, "enhanced_spread_thresh", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(enhanced_spread_threshold, "#.####"), text_color=color.white)
    row += 1

    table.cell(debugTable, 0, row, "--- SIGNALS ---", text_color=color.black, bgcolor=color.new(color.purple,0))
    table.cell(debugTable, 1, row, "", bgcolor=color.new(color.purple,0))
    row += 1
    
    table.cell(debugTable, 0, row, "inBand", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(inBand), text_color=inBand ? color.red : color.green)
    row += 1
    
    table.cell(debugTable, 0, row, "farAbove", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(farAbove), text_color=farAbove ? color.green : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "farBelow", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(farBelow), text_color=farBelow ? color.green : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "spreadUp", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(spreadUp), text_color=spreadUp ? color.green : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "spreadDn", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(spreadDn), text_color=spreadDn ? color.green : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "wantLong", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(wantLong), text_color=wantLong ? color.lime : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "wantShort", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(wantShort), text_color=wantShort ? color.red : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "longEvent", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(longEvent), text_color=longEvent ? color.lime : color.gray)
    row += 1
    
    table.cell(debugTable, 0, row, "shortEvent", text_color=color.white)
    table.cell(debugTable, 1, row, str.tostring(shortEvent), text_color=shortEvent ? color.red : color.gray)
    row += 1

// Markers
showMarkers = input.bool(true, "Show Signal Markers")
showCVDMarkers = input.bool(false, "Show CVD Divergence Markers")
plotshape(showMarkers and longEvent,  title="Long",  style=shape.triangleup,   location=location.bottom, color=color.white, size=size.normal)
plotshape(showMarkers and shortEvent, title="Short", style=shape.triangledown, location=location.top,    color=#ceb70b,     size=size.normal)
plotshape(showCVDMarkers and enableCVD and cvd_bull_div, title="CVD Bull Div", style=shape.circle,
          location=location.bottom, color=color.lime, size=size.tiny, text="CVD+")
plotshape(showCVDMarkers and enableCVD and cvd_bear_div, title="CVD Bear Div", style=shape.circle,
          location=location.top, color=color.red, size=size.tiny, text="CVD-")

// Alerts
alertcondition(longEvent,  "Enhanced Long",  "PCA-BC Enhanced long signal")
alertcondition(shortEvent, "Enhanced Short", "PCA-BC Enhanced short signal")

pFast = plot(fast, title="Fast", color=color.white)
pSlow = plot(slow, title="Slow", color=#ceb70b)
fill(pFast, pSlow, fast > slow ? color.white : #ceb70b)
hline(0, "Zero", color=color.gray)
avgConc = ta.sma(conc, regime_lookback)
bgcolor(conc > avgConc ? color.new(#8236FD, 80) : color.new(#0E0741, 80))

regime_bg_color = switch vix_ts_regime
    -2 => color.new(color.red, 97)
    -1 => color.new(color.orange, 97)
    1 => color.new(color.yellow, 97)
    2 => color.new(color.purple, 97)
    => na
bgcolor(useEnhancedVixFiltering ? regime_bg_color : na, title="VIX Regime Background")
show_dynamic_bands = input.bool(false, "Show Dynamic Threshold Bands", group=groupDynamic)
plot(show_dynamic_bands ? math.max(math.min(enhanced_band_threshold * sigProj,6),-6) : na, title="Dynamic Upper Band", 
     color=color.new(color.blue, 70), linewidth=1)
plot(show_dynamic_bands ? math.max(math.min(-enhanced_band_threshold * sigProj,6), -6) : na, title="Dynamic Lower Band", 
     color=color.new(color.blue, 70), linewidth=1)

// Context calculations for table
flat_th  = input.float(0.01, "Flat threshold (±%)", step=0.001)
steep_th = input.float(0.10, "Steep threshold (≥%)", step=0.01)

f_bucket(v) =>
    na(v) ? "n/a" :
     v > steep_th  ? "Steep Contango (upward)" :
     v > flat_th   ? "Contango (upward)" :
     v < -steep_th ? "Deep Backwardation (inverted)" :
     v < -flat_th  ? "Backwardation (inverted)" : "Flat (~0%)"

frontCtx = f_bucket(m2m1)
backCtx  = f_bucket(m3m1)
shortCtx = na(shortSlope) ? "n/a" : shortSlope > flat_th ? "VX1 > VIX9D (elevated near-term)" : shortSlope < -flat_th ? "VIX9D > VX1 (front kink/panic)" : "Flat short-end" 
curveShape = na(m2m1) or na(m3m1) ? "n/a" : (m2m1 > flat_th and m3m1 > m2m1 + flat_th) ? "Upward-sloping (steepening)" : (m2m1 > flat_th and m3m1 > flat_th and m3m1 < m2m1 - flat_th) ? "Contango, flattening" : (m2m1 < -flat_th and m3m1 > flat_th) ? "Front inversion only" : (m2m1 < -flat_th and m3m1 < -flat_th) ? "Inverted (backwardation)" : "Flat / transition"

// Enhanced Table with refined metrics
var t = table.new(position.top_right, 2, 16, border_width=1, frame_color=color.new(color.white, 50))
if barstate.islast and showTable
    table.cell(t,0,0,"Key",   text_color=color.yellow, bgcolor=color.new(color.black,0))
    table.cell(t,1,0,"Value", text_color=color.yellow, bgcolor=color.new(color.black,0))
    table.cell(t,0,1,"PCA Window", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,1,str.tostring(pca_window), text_color=color.white)
    table.cell(t,0,2,"EMAs (fast/slow)", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,2,str.tostring(fast_len)+" / "+str.tostring(slow_len), text_color=color.white)
    table.cell(t,0,3,"TFs (INTERNALS / VX / VIX)", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,3,data_tf+" / "+vx_tf+" / "+vix_tf, text_color=color.white)
    table.cell(t,0,4,"VIX Term Structure", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,4,tsLabel, bgcolor=tsColor, text_color=color.blue)
    table.cell(t,0,5,"VIX M2/M1", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,5,f_pct(m2m1), text_color=color.white)
    table.cell(t,0,6,"VIX M3/M1", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,6,f_pct(m3m1), text_color=color.white)
    table.cell(t,0,7,"VX1 vs VIX9D", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,7,f_pct(shortSlope), text_color=color.white)
    table.cell(t,0,8,"Curve Shape", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,8,curveShape, text_color=color.blue, bgcolor=tsColor)
    table.cell(t,0,9,"Front Slope Context", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,9,frontCtx, text_color=color.white)
    table.cell(t,0,10,"Back Slope Context", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,10,backCtx, text_color=color.white)
    table.cell(t,0,11,"Short-End Context", text_color=color.black,bgcolor=color.new(color.white,0))
    table.cell(t,1,11,shortCtx, text_color=color.white)
    
    // CVD Analysis Row
    table.cell(t,0,12,"CVD Analysis", text_color=color.black, bgcolor=color.new(color.white,0))
    cvd_status = not enableCVD ? "Disabled" : cvd_bull_div ? "STRONG Bull" : cvd_bear_div ? "STRONG Bear" : "Normal"
    cvd_color = cvd_bull_div ? color.lime : cvd_bear_div ? color.red : color.gray
    table.cell(t,1,12,cvd_status, text_color=cvd_color)

    // Dynamic Thresholds Row
    table.cell(t,0,13,"Dynamic Threshold", text_color=color.black, bgcolor=color.new(color.white,0))
    threshold_status = useDynamicThresholds ? str.tostring(current_threshold_multiplier, "#.##") + "x" : "Static"
    threshold_color = current_threshold_multiplier > 1.3 ? color.red : current_threshold_multiplier < 0.9 ? color.green : color.white
    table.cell(t,1,13,threshold_status, text_color=threshold_color)

    // VIX Regime Enhanced Row
    table.cell(t,0,14,"VIX Regime Enhanced", text_color=color.black, bgcolor=color.new(color.white,0))
    regime_color = switch vix_ts_regime
        -2 => color.red
        -1 => color.orange
        0 => color.gray
        1 => color.yellow
        2 => color.purple
        => color.gray
    table.cell(t,1,14,vix_risk_regime + " (" + str.tostring(vix_regime_multiplier, "#.##") + "x)", text_color=regime_color)

    // Signal Strength Row
    table.cell(t,0,15,"Signal Strength", text_color=color.black, bgcolor=color.new(color.white,0))
    current_strength = inLong ? signal_strength_long : inShort ? signal_strength_short : 0.0
    strength_text = current_strength == 0.0 ? "None" : str.tostring(current_strength, "#.##")
    strength_color = current_strength > 1.8 ? color.lime : current_strength > 1.2 ? color.green : current_strength > 0.8 ? color.yellow : color.gray
    table.cell(t,1,15,strength_text, text_color=strength_color)
